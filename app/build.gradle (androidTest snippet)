android {
    defaultConfig {
        testInstrumentationRunner "com.dsg.app.runner.CucumberAndroidJUnitRunner"
        testInstrumentationRunnerArguments = [
            cucumberOptions: "--plugin pretty --plugin junit:reports/cucumber.xml --glue com.dsg.app.steps --glue com.dsg.app.hooks",
            username: "defaultuser",
            password: "defaultpass"
        ]
    }
}

dependencies {
    androidTestImplementation 'androidx.test:runner:1.5.2'
    androidTestImplementation 'androidx.test.espresso:espresso-core:3.5.1'
    androidTestImplementation 'androidx.test.espresso:espresso-intents:3.5.1'
    androidTestImplementation 'io.cucumber:cucumber-android:7.0.0'
    androidTestImplementation 'io.cucumber:cucumber-picocontainer:7.0.0'
    androidTestImplementation 'androidx.test.uiautomator:uiautomator:2.2.0'
}